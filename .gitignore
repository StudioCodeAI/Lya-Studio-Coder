# ============================================================================
#  BLINDAGEM DE DISTRIBUIÇÃO — Lya Studio Coder
#  Este repositório versiona SOMENTE a vitrine pública (README, docs, canal de
#  feedback e imagens oficiais). TODO o código-fonte, build, dados e configs
#  ficam LOCAIS e NUNCA são enviados ao GitHub.
#  Estratégia: whitelist — ignora tudo e libera só o que pode ir ao ar.
#  Os instaladores .exe/.msi são distribuídos via GitHub Releases, não pelo git.
# ============================================================================

# 1) Ignora TUDO por padrão
/*

# 2) Arquivos da vitrine na raiz
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/SECURITY.md

# 3) Pastas da vitrine
!/docs/
!/.github/
!/assets/

# 3b) Em docs: vitrine pública, EXCETO material interno (runbooks, mockups, infra de orquestração)
/docs/ASSINATURA-A3.md
/docs/mockups/
/docs/paperclip-setup/

# 4) Em .github: templates de feedback, financiamento e workflows de CI/CD
/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/FUNDING.yml
!/.github/workflows/

# 5) Em assets: só as imagens oficiais da vitrine (não os originais do projeto)
/assets/*
!/assets/lya-logo.jpg
!/assets/lya-brand.jpg
!/assets/lya-core.png
!/assets/lya-icon.png
# screenshots da galeria — só os verificados/usados (sem caminhos com username)
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/tela-geral.png
!/assets/screenshots/provedores.png
!/assets/screenshots/orquestracao.png
!/assets/screenshots/editor.png
!/assets/screenshots/compilador.png
!/assets/screenshots/n8n.png
!/assets/screenshots/skills.png

# Garantias extras (redundância contra vazamento de código/segredos)
*.env
.env*
.env.example
src/
src-tauri/
server.ts
node_modules/
dist/
runtime/
engines/
*.exe
*.msi
