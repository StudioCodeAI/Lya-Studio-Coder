        <!-- SWIMLANES: COSMOS | Star 4 | Stars 1-3 | Sistema -->
        <!-- ══════════════════════════════════════════════════ -->

        <!-- COSMOS lane -->
        <mxCell id="lane-cosmos" value="COSMOS&#xa;Orquestrador" style="swimlane;startSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1560" height="160" as="geometry"/>
        </mxCell>
        <!-- Star 4 lane -->
        <mxCell id="lane-star4" value="Star 4&#xa;Cérebro/Memória" style="swimlane;startSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1560" height="160" as="geometry"/>
        </mxCell>
        <!-- Stars 1-3 lane -->
        <mxCell id="lane-stars" value="Stars 1-3&#xa;Workers Genéricos" style="swimlane;startSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1560" height="160" as="geometry"/>
        </mxCell>
        <!-- Sistema lane -->
        <mxCell id="lane-sys" value="Sistema&#xa;(Backend)" style="swimlane;startSize=50;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="1560" height="120" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- ESTADOS — linha do tempo -->
        <!-- ══════════════════════════════════════════════════ -->

        <!-- PENDING -->
        <mxCell id="s-pending" value="PENDING&#xa;Ordem registrada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#888888;fontSize=11;" vertex="1" parent="lane-cosmos">
          <mxGeometry x="30" y="75" width="120" height="65" as="geometry"/>
        </mxCell>

        <!-- PLANNING -->
        <mxCell id="s-planning" value="PLANNING&#xa;Pré-voo Stars&#xa;queryMemory()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane-cosmos">
          <mxGeometry x="200" y="75" width="130" height="65" as="geometry"/>
        </mxCell>

        <!-- STAR4_PREFLIGHT (novo) -->
        <mxCell id="s-preflight" value="STAR4_PREFLIGHT ★&#xa;Star 4 consulta ChromaDB&#xa;Compila MB [1][5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="lane-star4">
          <mxGeometry x="395" y="65" width="165" height="75" as="geometry"/>
        </mxCell>

        <!-- DISTRIBUTING -->
        <mxCell id="s-dist" value="DISTRIBUTING&#xa;COSMOS escreve MB [2][3][4]&#xa;Distribuição dinâmica por capabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="lane-cosmos">
          <mxGeometry x="620" y="75" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- EXECUTING -->
        <mxCell id="s-exec" value="EXECUTING&#xa;Stars 1-3 em PARALELO&#xa;Quadro Negro injetado no prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="lane-stars">
          <mxGeometry x="870" y="65" width="195" height="75" as="geometry"/>
        </mxCell>

        <!-- CONSOLIDATING -->
        <mxCell id="s-cons" value="CONSOLIDATING&#xa;COSMOS revisa entregas&#xa;Verif. determinística + LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lane-cosmos">
          <mxGeometry x="1110" y="75" width="200" height="65" as="geometry"/>
        </mxCell>

        <!-- STAR4_ARCHIVING (novo) -->
        <mxCell id="s-archive" value="STAR4_ARCHIVING ★&#xa;Star 4: memory_add → ChromaDB&#xa;Relatório estruturado da missão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="lane-star4">
          <mxGeometry x="1110" y="65" width="200" height="75" as="geometry"/>
        </mxCell>

        <!-- INDEXING -->
        <mxCell id="s-index" value="INDEXING&#xa;indexMissionSummary()&#xa;ChromaDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="lane-sys">
          <mxGeometry x="1360" y="30" width="150" height="65" as="geometry"/>
        </mxCell>

        <!-- DONE -->
        <mxCell id="s-done" value="DONE ✅" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="lane-cosmos">
          <mxGeometry x="1420" y="75" width="110" height="65" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- SETAS ENTRE ESTADOS -->
        <!-- ══════════════════════════════════════════════════ -->
        <!-- PENDING → PLANNING -->
        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s-pending" target="s-planning" parent="lane-cosmos">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- PLANNING → STAR4_PREFLIGHT (cross-lane) -->
        <mxCell id="ea2" value="Star 4 online?" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" source="s-planning" target="s-preflight" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- STAR4_PREFLIGHT → DISTRIBUTING -->
        <mxCell id="ea3" value="entrega MB [1][5]" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;" edge="1" source="s-preflight" target="s-dist" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- PLANNING → DISTRIBUTING (fallback) -->
        <mxCell id="ea4" value="(offline fallback)" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;dashed=1;strokeColor=#aaaaaa;" edge="1" source="s-planning" target="s-dist" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="265" y="225"/>
              <mxPoint x="720" y="225"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- DISTRIBUTING → EXECUTING -->
        <mxCell id="ea5" value="tasks + MB completo" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;" edge="1" source="s-dist" target="s-exec" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- EXECUTING → CONSOLIDATING -->
        <mxCell id="ea6" value="entregas paralelas" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;" edge="1" source="s-exec" target="s-cons" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- CONSOLIDATING → STAR4_ARCHIVING -->
        <mxCell id="ea7" value="resultado consolidado" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;" edge="1" source="s-cons" target="s-archive" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- STAR4_ARCHIVING → INDEXING -->
        <mxCell id="ea8" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s-archive" target="s-index" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- CONSOLIDATING → INDEXING (fallback) -->
        <mxCell id="ea9" value="(offline fallback)" style="edgeStyle=orthogonalEdgeStyle;fontStyle=2;fontSize=9;dashed=1;strokeColor=#aaaaaa;" edge="1" source="s-cons" target="s-index" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <!-- INDEXING → DONE -->
        <mxCell id="ea10" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s-index" target="s-done" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ══════════════════════════════════════════════════ -->
        <!-- CAIXAS DE DETALHE: STAR 4 PREFLIGHT -->
        <!-- ══════════════════════════════════════════════════ -->
        <mxCell id="d-preflight" value="Star 4 — PREFLIGHT&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;1. memory_search(goal) → ChromaDB&#xa;2. Filtra hits relevantes (top 8)&#xa;3. Compila seções do MB:&#xa;   [1] Stack + padrões + módulos críticos&#xa;   [5] Decisões anteriores + riscos ativos&#xa;4. Regra anti-alucinação: só escreve com fonte&#xa;→ Retorna texto formatado ao COSMOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="80" y="780" width="360" height="175" as="geometry"/>
        </mxCell>

        <!-- CAIXAS DE DETALHE: COSMOS DISTRIBUTING -->
        <mxCell id="d-dist" value="COSMOS — DISTRIBUTING (Dynamic Distribution ★)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;1. Recebe MB [1][5] de Star 4&#xa;2. Lê capabilities de cada Star (canCode/canReview/...)&#xa;3. Avalia missão: trivial → resolve sozinho&#xa;                  paralelizável → convoca Stars&#xa;4. Decide quantas Stars usar (1, 2 ou todas)&#xa;5. Escreve MB [2] Missão · [3] Caminho · [4] Tarefas&#xa;6. Injeta m.blackboard em todas as Stars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4ff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="780" width="420" height="175" as="geometry"/>
        </mxCell>

        <!-- CAIXAS DE DETALHE: STAR4 ARCHIVING -->
        <mxCell id="d-archive" value="Star 4 — ARCHIVING&#xa;━━━━━━━━━━━━━━━━━━━━&#xa;1. Recebe resultado consolidado do COSMOS&#xa;2. Cria relatório estruturado:&#xa;   - objetivo, decisões, padrões, resultado&#xa;3. Chama memory_add → ChromaDB&#xa;   topic: 'missão: &lt;objetivo&gt;'&#xa;   category: 'mission' · importance: 8&#xa;4. Próxima missão encontra contexto desta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="940" y="780" width="360" height="175" as="geometry"/>
        </mxCell>

        <!-- Quadro Negro (Mission Blackboard) box -->
        <mxCell id="d-mb" value="📋 QUADRO NEGRO (Mission Blackboard)&#xa;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━&#xa;[1] Contexto do Projeto — Star 4 escreve&#xa;[2] Missão Atual — COSMOS escreve&#xa;[3] Caminho a Seguir — COSMOS escreve&#xa;[4] Tarefas e Entregas — COSMOS escreve&#xa;[5] Decisões Anteriores + Riscos — Star 4 escreve&#xa;&#xa;→ m.blackboard injetado no system prompt de toda Star" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#f9a825;fontSize=10;align=left;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="780" width="270" height="175" as="geometry"/>
        </mxCell>

        <!-- setas de detalhe -->
        <mxCell id="ed1" style="dashed=1;strokeColor=#9673a6;" edge="1" source="s-preflight" target="d-preflight" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed2" style="dashed=1;strokeColor=#6c8ebf;" edge="1" source="s-dist" target="d-dist" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed3" style="dashed=1;strokeColor=#9673a6;" edge="1" source="s-archive" target="d-archive" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed4" style="dashed=1;strokeColor=#f9a825;" edge="1" source="s-exec" target="d-mb" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- LEGENDA Estados -->
        <mxCell id="leg2" value="★ = Novo (TURNO 10)   |   Linha tracejada = fallback (Star 4 offline)   |   Todos os estados de STOPPED/FAILED omitidos para clareza" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1560" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
